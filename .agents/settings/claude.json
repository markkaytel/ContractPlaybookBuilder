{
  "permissions": {
    "allow": [
      "Read",
      "WebFetch",
      "WebSearch",
      "Glob",
      "Grep",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Skill(docx-editing-superdoc)",
      "Skill(docx-processing-anthropic)",
      "Skill(docx-processing-openai)",
      "Skill(legal-simulation-patrick-munro)",
      "Skill(nda-review-jamie-tso)",
      "Skill(pdf-processing-anthropic)",
      "Skill(pdf-processing-openai)",
      "Skill(politique-confidentialite-malik-taiar)",
      "Skill(pptx-processing-anthropic)",
      "Skill(skill-creator-anthropic)",
      "Skill(skill-creator-openai)",
      "Skill(skill-optimizer-malik-taiar)",
      "Skill(statute-analysis-rafal-fryc)",
      "Skill(tabular-review-antoine-louis)",
      "Skill(tech-contract-negotiation-patrick-munro)",
      "Skill(vendor-due-diligence-patrick-munro)",
      "Skill(xlsx-processing-anthropic)",
      "Skill(xlsx-processing-openai)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.agents/hooks/enforce-uv-install.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run $CLAUDE_PROJECT_DIR/.agents/hooks/enforce-uv-run.py"
          },
          {
            "type": "command",
            "command": "uv run $CLAUDE_PROJECT_DIR/.agents/hooks/block-dangerous-commands.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "uv run $CLAUDE_PROJECT_DIR/.agents/hooks/enforce-skill-use.py"
          }
        ]
      }
    ]
  },
  "alwaysThinkingEnabled": true
}