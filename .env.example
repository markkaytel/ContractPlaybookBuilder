# Contract Playbook Builder - Environment Configuration
# Copy this file to .env and fill in your values
# cp .env.example .env

# =============================================================================
# AI PROVIDER SETTINGS (Required - choose one)
# =============================================================================

# Option 1: Anthropic Claude API (Recommended)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Option 2: OpenAI API
# Get your key at: https://platform.openai.com/api-keys
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_MODEL=gpt-4o

# Option 3: OpenAI-Compatible API (e.g., LM Studio, Ollama, vLLM, etc.)
# Set the API key and custom base URL for your provider
# OPENAI_API_KEY=your-api-key-or-dummy-key
# OPENAI_BASE_URL=http://localhost:1234/v1
# OPENAI_MODEL=your-model-name

# Which provider to use (anthropic or openai)
# AI_PROVIDER=anthropic

# =============================================================================
# GOOGLE SEARCH SETTINGS (Optional - for web research feature)
# =============================================================================

# Google Custom Search API credentials
# Get your API key at: https://console.cloud.google.com/
# Create a search engine at: https://programmablesearchengine.google.com/
# GOOGLE_API_KEY=your-google-api-key-here
# GOOGLE_SEARCH_ENGINE_ID=your-search-engine-id-here

# =============================================================================
# OPTIONAL SETTINGS
# =============================================================================

# Server port (default: 3005)
# PORT=3005

# Maximum file upload size in MB (default: 50)
# MAX_FILE_SIZE=50

# Enable debug mode (default: 0)
# FLASK_DEBUG=0