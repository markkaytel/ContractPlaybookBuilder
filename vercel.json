{
  "version": 2,
  "builds": [
    {
      "src": "api/*.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb",
        "runtime": "python3.12"
      }
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/css/(.*)", "dest": "/public/css/$1" },
    { "src": "/js/(.*)", "dest": "/public/js/$1" },
    { "src": "/api/upload", "dest": "/api/upload.py" },
    { "src": "/api/health", "dest": "/api/health.py" },
    { "src": "/(.*)", "dest": "/api/index.py" }
  ],
  "functions": {
    "api/upload.py": {
      "maxDuration": 300,
      "memory": 1024
    },
    "api/index.py": {
      "maxDuration": 10
    },
    "api/health.py": {
      "maxDuration": 10
    }
  }
}
